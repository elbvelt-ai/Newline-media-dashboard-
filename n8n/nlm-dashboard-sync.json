    {
      "parameters": {
        "jsCode": "// Map Zoho Desk ticket -> tickets table columns\nconst now = new Date().toISOString();\nconst ts = v => (v ? new Date(v).toISOString() : null);\nconst a = $input.all().map(i => i.json);\nreturn a.map(t => ({ json: {\n  ticket_id: String(t.id),\n  ticket_number: t.ticketNumber ? String(t.ticketNumber) : null,\n  subject: t.subject || null,\n  status: t.status || null,\n  priority: t.priority || null,\n  assignee_id: t.assigneeId || null,\n  assignee: t.assignee ? ((t.assignee.firstName || '') + ' ' + (t.assignee.lastName || '')).trim() : null,\n  department: t.department ? t.department.name : null,\n  account: (t.contact && t.contact.account && t.contact.account.accountName) || null,\n  category: t.category || null,\n  sub_category: t.subCategory || null,\n  created_time: ts(t.createdTime),\n  due_date: ts(t.dueDate),\n  closed_time: ts(t.closedTime),\n  modified_time: ts(t.modifiedTime),\n  updated_at: now\n}}));"
      },
      "name": "Map Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
